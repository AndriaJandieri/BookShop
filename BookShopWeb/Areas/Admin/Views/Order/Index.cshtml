@model List<OrderVM>

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">
                    Order List
                </h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">


        <table id="tableData" class="table table-bordered table-striped bg-primary" style="width:100%">

            <thead>
                <tr>
                    <th class="bg-primary text-light">
                        ID
                    </th>
                    <th class="bg-primary text-light">
                        Name
                    </th>
                    <th class="bg-primary text-light">
                        Phone Number
                    </th>
                    <th class="bg-primary text-light">
                        Email
                    </th>
                    <th class="bg-primary text-light">
                        Status
                    </th>
                    <th class="bg-primary text-light">
                        Total
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>

    </div>
</div>

@section Scripts {
    <script src="~/js/order.js"></script>
}